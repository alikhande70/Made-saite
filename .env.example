# ---- Database ----
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/madesaite

# ---- App ----
# Absolute origin of this deployment. Used for canonical URLs, the sitemap,
# Open Graph tags and payment callback URLs. Read at RUNTIME (not inlined at
# build time), so one build can be promoted between environments.
# In production this MUST be https:// — session and cart cookies are marked
# Secure only when it is. See docs/SECURITY.md.
SITE_URL=http://localhost:3000
NODE_ENV=development

# ---- Auth ----
# 32+ random bytes, base64. Generate: openssl rand -base64 48
AUTH_SECRET=CHANGE_ME_dev_only_secret_at_least_32_chars_long_xxxxx

# ---- Payments ----
# Active provider id: "mock" | "cod"
PAYMENT_PROVIDER=mock
# HMAC secret used to sign mock-gateway callbacks (prevents callback spoofing)
MOCK_GATEWAY_SECRET=CHANGE_ME_dev_only_gateway_secret_xxxxxxxxxxxxxxxx

# ---- Real gateways (NOT configured; see docs/PAYMENTS.md) ----
# ZARINPAL_MERCHANT_ID=
# IDPAY_API_KEY=

# ---- Ops ----
# Minutes an unpaid order holds its stock reservation before it is auto-released
ORDER_PAYMENT_TTL_MINUTES=30
