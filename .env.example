###############################################################################
# Made-saite — environment contract
#
# Every variable the application reads is listed here exactly once, with what
# happens when it is wrong. Copy to `.env` for development, or to
# `.env.production` on a server (that file is git-ignored and must never be
# committed or copied into a container image).
#
# Classification, used throughout:
#
#   REQUIRED-PROD  the process refuses to start in production without it
#   REQUIRED-ALL   nothing works without it, in any environment
#   OPTIONAL       has a safe default
#   SECRET         never log it, never commit it, rotate it if exposed
#   PUBLIC         may be sent to the browser; assume it is public
#   DEV-ONLY       must not appear on a production host
#   TEST-ONLY      set by the test harness; never set it by hand
#
# The production checks live in src/lib/production-config.ts and run once at
# startup. They apply only to a *live* deployment — NODE_ENV=production with a
# SITE_URL that is not localhost — so a production build served locally for
# verification stays exempt. See docs/OPERATIONS.md.
###############################################################################

# ── Database ─────────────────────────────────────────────────────────────────

# REQUIRED-ALL · SECRET
# Refused in production when it names a database ending in _test, _e2e, _dev,
# _development, _scratch or _tmp: pointing a live store at a scratch database
# works, and is then wiped by the next test run.
# Refused when the password looks like a placeholder.
# Warned when there is no password at all — acceptable only when access is
# already restricted at the network level (the compose file publishes no port).
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/madesaite

# OPTIONAL · default 10
# Maximum pooled connections per application process. The ceiling is
# PostgreSQL's own max_connections divided by the number of processes; setting
# it too high converts a traffic spike into "too many clients already".
# PG_POOL_MAX=10

# ── Application ──────────────────────────────────────────────────────────────

# REQUIRED-PROD · PUBLIC
# The absolute origin this deployment is served from. Canonical URLs, the
# sitemap, Open Graph tags and — most importantly — payment callback URLs are
# built from it. Read at runtime, not inlined at build time, so one image can
# be promoted from staging to production unchanged.
#
# MUST be https:// in production. Session and cart cookies are marked Secure
# from this scheme, so an http:// value here silently downgrades every cookie
# in the application. The startup check refuses to boot on it.
SITE_URL=http://localhost:3000

# REQUIRED-ALL
# `production` on any deployed host. `development` enables the Next dev
# overlay, which requires 'unsafe-eval' in the CSP.
NODE_ENV=development

# OPTIONAL · PUBLIC · legacy fallback, only read when SITE_URL is unset
# SITE_URL always wins when both are set. Kept so an older deployment that
# only ever set this one keeps working. New deployments should leave it unset
# and set SITE_URL.
# NEXT_PUBLIC_SITE_URL=

# ── Authentication ───────────────────────────────────────────────────────────

# REQUIRED-ALL · SECRET
# Session tokens are derived from this. Rotating it signs every user out,
# which is the correct response to a suspected leak.
# Generate: openssl rand -base64 48
AUTH_SECRET=CHANGE_ME_dev_only_secret_at_least_32_chars_long_xxxxx

# ── Payments ─────────────────────────────────────────────────────────────────

# REQUIRED-PROD
# One of: mock | cod | zarinpal | idpay
# There is deliberately no default. An unset provider in production is a
# refusal to start, not a fallback, because every fallback is either "take no
# money" or "take money through an unconfigured gateway".
PAYMENT_PROVIDER=mock

# REQUIRED when PAYMENT_PROVIDER=mock · SECRET
# HMAC secret signing mock-gateway callbacks, so a callback cannot be forged
# by anyone who knows an order number.
MOCK_GATEWAY_SECRET=CHANGE_ME_dev_only_gateway_secret_xxxxxxxxxxxxxxxx

# OPTIONAL · default unset (refused)
# The sandbox gateway records orders as paid with no money taken. On a live
# deployment that is indistinguishable from fraud, so PAYMENT_PROVIDER=mock is
# refused unless this is explicitly `true`.
#
# Set it on a staging host that deliberately wants the sandbox. NEVER on a
# real store. It is logged as a warning on every boot so it cannot be
# forgotten.
# ALLOW_SANDBOX_PAYMENTS=true

# REQUIRED when PAYMENT_PROVIDER=zarinpal · SECRET
# Issued by the provider to the merchant. Not held by this project — see
# docs/OPERATIONS.md, "Payment provider handoff".
# ZARINPAL_MERCHANT_ID=

# REQUIRED when PAYMENT_PROVIDER=idpay · SECRET
# IDPAY_API_KEY=

# ── Reverse proxy ────────────────────────────────────────────────────────────

# OPTIONAL · default 0 · strongly recommended in production
# The number of reverse proxies between the internet and this process. The
# client address is taken by counting back exactly this many entries from the
# right-hand end of X-Forwarded-For, because only the last N entries are
# appended by infrastructure we control.
#
#   unset / 0  the header is ignored and every visitor shares one rate-limit
#              bucket — safe, but it throttles the whole site under load
#   1          one proxy (Caddy, nginx, or a single load balancer). Usual.
#   2          proxy behind a CDN that also appends
#
# Setting it too HIGH is the dangerous direction: it starts trusting entries
# the client wrote, which reopens the rate-limit bypass. If unsure, use 1.
# TRUSTED_PROXY_HOPS=1

# ── Operations ───────────────────────────────────────────────────────────────

# OPTIONAL · default 30
# Minutes an unpaid order holds its stock reservation before the sweeper
# releases it. Too short strands shoppers mid-payment; too long lets abandoned
# checkouts hide sellable stock.
ORDER_PAYMENT_TTL_MINUTES=30

# OPTIONAL · default 5
# How often the in-process sweeper releases stock from expired unpaid orders
# and prunes expired sessions and rate-limit windows. Clamped to a one-minute
# floor; a value that is not a positive number falls back to the default.
# The production image has no `tsx`, so `npm run db:sweep` cannot run in a
# container — this timer is what releases stranded stock there. See
# docs/OPERATIONS.md §14.
# SWEEP_INTERVAL_MINUTES=5

# OPTIONAL · default unset
# Set to `true` only if an external scheduler runs `npm run db:sweep` instead.
# Setting it with nothing else in place means stock is never released.
# DISABLE_BACKGROUND_JOBS=true

# OPTIONAL · default info
# One of: debug | info | warn | error. `debug` is noisy and may log request
# shapes; keep it to short investigations.
# LOG_LEVEL=info

# OPTIONAL · default 3000 · compose only
# Host port the app is published on, bound to 127.0.0.1 for a reverse proxy in
# front. Do not bind it to 0.0.0.0 — that bypasses TLS termination.
# APP_PORT=3000

# OPTIONAL · default 14 · scripts/backup-db.sh only
# BACKUP_RETENTION_DAYS=14

# ── Test harness (TEST-ONLY — never set these on a server) ────────────────────
# E2E_DB_NAME   database the Playwright suite creates and drops (default madesaite_e2e)
# E2E_PORT      port the Playwright web server listens on (default 3100)
# PW_CHROME_PATH  explicit Chromium binary for environments with a preinstalled one
# CI            set by the CI provider; makes the suite stricter (no retries reuse)
